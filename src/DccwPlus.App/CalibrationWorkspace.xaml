<UserControl x:Class="DccwPlus.App.CalibrationWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:DccwPlus.App">
  <Grid x:Name="WorkspaceRoot" MaxWidth="1176">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="WideCommands">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="850" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="CalibrationCommands.(Grid.Row)" Value="0" />
            <Setter Target="CalibrationCommands.(Grid.Column)" Value="1" />
            <Setter Target="CalibrationCommands.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="CalibrationCommands.Margin" Value="0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="CompactCommands">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid ColumnSpacing="12" Margin="24,12,24,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ComboBox x:Name="StepPicker" SelectionChanged="StepChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Text[WizardStep]}" />
      <Button x:Name="FullScreenButton" Grid.Column="1" Content="{Binding Text[FullScreen]}" Click="FullScreenClicked" />
    </Grid>
    <ScrollViewer x:Name="StepScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="24,2,24,16"
                  SizeChanged="StepScrollSizeChanged">
      <StackPanel Spacing="14">
        <StackPanel x:Name="PreparationControls" Spacing="14">
          <TextBlock Text="{Binding Text[WizardSubtitle]}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <Border Style="{StaticResource Card}">
            <StackPanel Spacing="8">
              <ComboBox x:Name="DisplayPicker" Header="{Binding Text[Display]}"
                        HorizontalAlignment="Stretch" SelectionChanged="DisplayChanged" AutomationProperties.Name="{Binding Text[Display]}">
                <ComboBox.ItemTemplate><DataTemplate>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock x:Name="DisplaySummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="IdentifyDisplayButton" Content="{Binding Text[IdentifyDisplay]}" Click="IdentifyDisplayClicked" />
                <Button x:Name="MoveDisplayButton" Content="{Binding Text[MoveToDisplay]}" Click="MoveDisplayClicked" />
                <Button x:Name="RefreshDisplaysButton" Content="{Binding Text[Refresh]}" Click="RefreshClicked" />
              </StackPanel>
              <TextBlock x:Name="DisplayGuidance" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              <HyperlinkButton x:Name="DisplaySettingsLink" Content="{Binding Text[OpenDisplaySettings]}"
                               NavigateUri="ms-settings:display" Visibility="Collapsed" />
              <HyperlinkButton x:Name="HdrCalibrationLink" Content="{Binding Text[OpenHdrCalibrationStore]}"
                               NavigateUri="ms-windows-store://pdp/?ProductId=9N7F2SM5D1LR" Visibility="Collapsed" />
              <Button x:Name="InspectCalibrationButton" Content="{Binding Text[InspectSavedCalibration]}" Click="InspectCalibrationClicked" />
              <TextBlock x:Name="InspectionResult" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>
        <InfoBar x:Name="RecoveryNotice" IsOpen="False" IsClosable="False" Severity="Warning" Title="{Binding Text[RecoveryTitle]}" Message="{Binding Text[RecoveryMessage]}">
          <InfoBar.ActionButton><Button x:Name="RecoveryButton" Content="{Binding Text[Recover]}" Click="RecoverClicked" /></InfoBar.ActionButton>
        </InfoBar>
        <local:PatternSurface x:Name="Pattern" Height="242" AutomationProperties.Name="{Binding Text[CalibrationPattern]}" />
        <TextBlock x:Name="StepInstructions" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBox x:Name="OriginalBrightnessNote" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="220" MaxWidth="360"
                 Header="{Binding Text[OriginalBrightness]}" Description="{Binding Text[HardwareNotesDescription]}"
                 AutomationProperties.Name="{Binding Text[OriginalBrightness]}"
                 MaxLength="64" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextChanging="HardwareNoteChanging" />
        <TextBox x:Name="OriginalContrastNote" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="220" MaxWidth="360"
                 Header="{Binding Text[OriginalContrast]}" Description="{Binding Text[HardwareNotesDescription]}"
                 AutomationProperties.Name="{Binding Text[OriginalContrast]}"
                 MaxLength="64" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextChanging="HardwareNoteChanging" />
        <StackPanel x:Name="GammaControls" Visibility="Collapsed" Spacing="12">
          <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
            <Slider x:Name="GammaSlider" Header="{Binding Text[GammaAdjustment]}" Minimum="1" Maximum="3" Value="2.2"
                    StepFrequency="0.02" SmallChange="0.02" LargeChange="0.20" ValueChanged="ValuesChanged" AutomationProperties.Name="{Binding Text[GammaAdjustment]}" />
            <NumberBox x:Name="GammaNumber" Grid.Column="1" Value="{Binding ElementName=GammaSlider, Path=Value, Mode=TwoWay}" Minimum="1" Maximum="3"
                       SmallChange="{Binding ElementName=GammaSlider, Path=SmallChange}" LargeChange="{Binding ElementName=GammaSlider, Path=LargeChange}"
                       SpinButtonPlacementMode="Compact" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Text[GammaAdjustment]}" />
          </Grid>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
              <local:PatternSurface x:Name="GammaLowPattern" Height="72" />
              <TextBlock Text="{Binding Text[GammaTooLow]}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <local:PatternSurface x:Name="GammaTargetPattern" Height="72" />
              <TextBlock Text="{Binding Text[GammaBalanced]}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <local:PatternSurface x:Name="GammaHighPattern" Height="72" />
              <TextBlock Text="{Binding Text[GammaTooHigh]}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </StackPanel>
        <Grid x:Name="BalanceControls" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Slider x:Name="RedSlider" Header="{Binding Text[Red]}" Minimum="0.5" Maximum="1.5" Value="1"
                  StepFrequency="0.01" SmallChange="0.01" LargeChange="0.10" ValueChanged="ValuesChanged" AutomationProperties.Name="{Binding Text[Red]}" />
          <NumberBox x:Name="RedNumber" Grid.Column="1" Value="{Binding ElementName=RedSlider, Path=Value, Mode=TwoWay}" Minimum="0.5" Maximum="1.5"
                     SmallChange="{Binding ElementName=RedSlider, Path=SmallChange}" LargeChange="{Binding ElementName=RedSlider, Path=LargeChange}"
                     SpinButtonPlacementMode="Compact" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Text[Red]}" />
          <Slider x:Name="GreenSlider" Grid.Row="1" Header="{Binding Text[Green]}" Minimum="0.5" Maximum="1.5" Value="1"
                  StepFrequency="0.01" SmallChange="0.01" LargeChange="0.10" ValueChanged="ValuesChanged" AutomationProperties.Name="{Binding Text[Green]}" />
          <NumberBox x:Name="GreenNumber" Grid.Row="1" Grid.Column="1" Value="{Binding ElementName=GreenSlider, Path=Value, Mode=TwoWay}" Minimum="0.5" Maximum="1.5"
                     SmallChange="{Binding ElementName=GreenSlider, Path=SmallChange}" LargeChange="{Binding ElementName=GreenSlider, Path=LargeChange}"
                     SpinButtonPlacementMode="Compact" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Text[Green]}" />
          <Slider x:Name="BlueSlider" Grid.Row="2" Header="{Binding Text[Blue]}" Minimum="0.5" Maximum="1.5" Value="1"
                  StepFrequency="0.01" SmallChange="0.01" LargeChange="0.10" ValueChanged="ValuesChanged" AutomationProperties.Name="{Binding Text[Blue]}" />
          <NumberBox x:Name="BlueNumber" Grid.Row="2" Grid.Column="1" Value="{Binding ElementName=BlueSlider, Path=Value, Mode=TwoWay}" Minimum="0.5" Maximum="1.5"
                     SmallChange="{Binding ElementName=BlueSlider, Path=SmallChange}" LargeChange="{Binding ElementName=BlueSlider, Path=LargeChange}"
                     SpinButtonPlacementMode="Compact" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Text[Blue]}" />
        </Grid>
        <StackPanel x:Name="ReviewControls" Visibility="Collapsed" Spacing="12">
          <ToggleSwitch x:Name="OriginalToggle" Header="{Binding Text[CompareOriginal]}" OnContent="{Binding Text[PreviousCalibration]}" OffContent="{Binding Text[CurrentCalibration]}" Toggled="CompareChanged" />
          <TextBlock x:Name="ComparisonState" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
          <TextBox x:Name="PresetName" Header="{Binding Text[PresetName]}" MaxLength="100" TextChanged="NameChanged" AutomationProperties.Name="{Binding Text[PresetName]}" />
          <CheckBox x:Name="ClearTypeOption" Content="{Binding Text[OpenClearType]}" />
        </StackPanel>
        <Expander x:Name="OriginalMonitorSettings" Header="{Binding Text[OriginalMonitorSettings]}" Visibility="Collapsed"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="6">
            <TextBlock x:Name="OriginalMonitorValues" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{Binding Text[RestoreMonitorSettingsManually]}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Expander>
        <Button x:Name="SaveDraftButton" Content="{Binding Text[SaveDraft]}" Click="SaveDraftClicked" />
        <Button x:Name="UndoCalibrationButton" Content="{Binding Text[UndoCalibration]}" Click="UndoCalibrationClicked" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Margin="24,0,24,0" Padding="0,8,0,12"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="8">
        <InfoBar x:Name="Outcome" IsOpen="False" IsClosable="True" Severity="Informational">
          <InfoBar.ActionButton>
            <HyperlinkButton x:Name="SavedDisplaySettingsLink" Content="{Binding Text[OpenDisplaySettings]}"
                             NavigateUri="ms-settings:display" Visibility="Collapsed" />
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar x:Name="ClearTypeNotice" IsOpen="False" IsClosable="True" Severity="Warning" Message="{Binding Text[ClearTypeLaunchFailed]}">
          <InfoBar.ActionButton><Button Content="{Binding Text[RetryOpenClearType]}" Click="RetryClearTypeClicked" /></InfoBar.ActionButton>
        </InfoBar>
        <TextBlock x:Name="CountdownText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        <Grid ColumnSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PreviousButton" Content="{Binding Text[Previous]}" Click="PreviousClicked" />
            <Button x:Name="NextButton" Content="{Binding Text[Next]}" Click="NextClicked" />
            <Button x:Name="ResetButton" Visibility="Collapsed" Content="{Binding Text[ResetStep]}" Click="ResetClicked" />
            <Button x:Name="SkipHardwareButton" Visibility="Collapsed" Content="{Binding Text[SkipHardwareAdjustments]}" Click="SkipHardwareClicked" />
          </StackPanel>
          <StackPanel x:Name="CalibrationCommands" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" Content="{Binding Text[StartCalibration]}" Style="{ThemeResource AccentButtonStyle}" Click="StartClicked" />
            <Button x:Name="CancelButton" Content="{Binding Text[CancelCalibration]}" Click="CancelClicked" Visibility="Collapsed" />
            <Button x:Name="FinishButton" Content="{Binding Text[FinishCalibration]}" Style="{ThemeResource AccentButtonStyle}" Click="FinishClicked" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
