<Window x:Class="DccwPlus.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:DccwPlus.App">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator x:Name="CancelPreviewKey" Key="Escape" IsEnabled="False" Invoked="CancelPreviewKeyInvoked" />
    </Grid.KeyboardAccelerators>
    <Grid x:Name="TitleBar" Background="Transparent" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="Assets/Square44x44Logo.png" Width="24" Height="24" />
        <TextBlock Text="DCCW++" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <InfoBar x:Name="BackgroundPreview" Grid.Row="1" IsOpen="False" IsClosable="False">
      <InfoBar.ActionButton>
        <Button x:Name="BackgroundPreviewAction" Click="BackgroundPreviewActionClicked" />
      </InfoBar.ActionButton>
    </InfoBar>
    <NavigationView x:Name="Navigation" Grid.Row="2" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
       PaneDisplayMode="Auto" OpenPaneLength="216" SelectionChanged="NavigationChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="CalibrationNav" Content="{Binding Text[Calibration]}" Tag="calibration">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="{Binding Text[Presets]}" Tag="presets"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="{Binding Text[References]}" Tag="references"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter><StackPanel Margin="16,8,16,16" Spacing="4">
        <TextBlock Text="DCCW++" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="0.2 · GPL-3.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
      </StackPanel></NavigationView.PaneFooter>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,32">
        <StackPanel Spacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
          <StackPanel x:Name="CalibrationPanel"><local:CalibrationWorkspace x:Name="Workspace" /></StackPanel>
          <StackPanel x:Name="PresetsPanel" Visibility="Collapsed" Spacing="20">
            <StackPanel Spacing="6"><TextBlock Text="{Binding Text[Presets]}" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="{Binding Text[PresetsSubtitle]}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{Binding Text[Import]}" Click="ImportClicked" Style="{ThemeResource AccentButtonStyle}" />
              <Button Content="{Binding Text[ImportCopy]}" Click="ImportCopyClicked" />
              <Button Content="{Binding Text[Refresh]}" Click="RefreshClicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{Binding Text[Export]}" Click="ExportClicked" />
              <Button Content="{Binding Text[LoadDraft]}" Click="LoadClicked" />
              <Button x:Name="RenamePresetButton" Content="{Binding Text[RenamePreset]}" Click="RenamePresetClicked" IsEnabled="False" />
              <Button x:Name="DeletePresetButton" Content="{Binding Text[DeletePreset]}" Click="DeletePresetClicked" IsEnabled="False" />
            </StackPanel>
            <ListView x:Name="PresetList" ItemsSource="{Binding Presets}" SelectionMode="Single" MinHeight="180"
                      SelectionChanged="PresetSelectionChanged" AutomationProperties.Name="{Binding Text[Presets]}">
              <ListView.ItemTemplate><DataTemplate><StackPanel Padding="12" Spacing="6">
                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Author}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="PresetBindingsText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding Text[PresetSafety]}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel x:Name="ReferencesPanel" Visibility="Collapsed" Spacing="20">
            <TextBlock Text="{Binding Text[References]}" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
              <TextBlock Text="{Binding Text[ReferenceTitle]}" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <TextBlock Text="{Binding Text[ReferenceMessage]}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Text[ReferenceCategories]}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button Content="{Binding Text[ChooseReferencePhotos]}" Click="ChoosePhotosClicked" />
              <ComboBox x:Name="PhotoPicker" DisplayMemberPath="Name" SelectionChanged="PhotoChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Text[References]}" />
              <Image x:Name="ReferencePhoto" MaxHeight="540" Stretch="Uniform" />
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="20">
            <TextBlock Text="{Binding Text[Settings]}" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
              <TextBlock Text="{Binding Text[Language]}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
              <ComboBox x:Name="LanguagePicker" SelectionChanged="LanguageChanged" MinWidth="220" AutomationProperties.Name="{Binding Text[Language]}">
                <ComboBoxItem Tag="system" Content="{Binding Text[SystemLanguage]}" /><ComboBoxItem Tag="en-US" Content="English" />
                <ComboBoxItem Tag="zh-Hans" Content="简体中文" /><ComboBoxItem Tag="zh-Hant" Content="繁體中文" />
              </ComboBox>
              <TextBlock Text="{Binding Text[LanguageHint]}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
              <ToggleSwitch x:Name="StartupToggle" Header="{Binding Text[Startup]}" OnContent="{Binding Text[On]}" OffContent="{Binding Text[Off]}" Toggled="StartupChanged" />
              <TextBlock x:Name="StartupStateText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{Binding Text[StartupHint]}" TextWrapping="Wrap" />
              <ComboBox x:Name="BindingPicker" Header="{Binding Text[BindingDisplay]}" DisplayMemberPath="Label"
                        HorizontalAlignment="Stretch" SelectionChanged="BindingSelectionChanged" />
              <ToggleSwitch x:Name="BindingToggle" Header="{Binding Text[BindingRestore]}" IsEnabled="False"
                            OnContent="{Binding Text[On]}" OffContent="{Binding Text[Off]}" Toggled="BindingChanged" />
              <Button x:Name="RemoveBindingButton" Content="{Binding Text[RemoveDisplayBinding]}" IsEnabled="False" Click="RemoveBindingClicked" />
              <TextBlock x:Name="BindingStateText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
              <TextBlock Text="{Binding Text[AgentTitle]}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="dccwpp --help --json" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
              <TextBlock Text="{Binding Text[AgentHint]}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{Binding DataDirectory}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
              <HyperlinkButton Content="GPL-3.0" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" />
            </StackPanel></Border>
          </StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
