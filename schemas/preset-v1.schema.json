{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCCW++ preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "createdAt", "calibration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
    "description": { "type": "string", "maxLength": 2000, "default": "" },
    "author": { "type": "string", "maxLength": 200, "default": "" },
    "createdAt": { "type": "string", "format": "date-time" },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "colorMode": { "const": "sdr", "default": "sdr" },
        "gamma": { "type": "number", "minimum": 1, "maximum": 3, "default": 2.2 },
        "redGain": { "type": "number", "minimum": 0.5, "maximum": 1.5, "default": 1 },
        "greenGain": { "type": "number", "minimum": 0.5, "maximum": 1.5, "default": 1 },
        "blueGain": { "type": "number", "minimum": 0.5, "maximum": 1.5, "default": 1 }
      }
    }
  }
}
